{
  "openapi": "3.1.0",
  "info": {
    "title": "Ferrum Execution Engine API",
    "version": "0.1.0",
    "description": "High-performance, isolated code execution and judging platform inspired by Judge0."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/v1/languages": {
      "get": {
        "summary": "List supported languages and runtime limits",
        "operationId": "listLanguages",
        "responses": {
          "200": {
            "description": "List of available language environments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LanguageResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/submissions": {
      "post": {
        "summary": "Create code execution or judging submission",
        "operationId": "createSubmission",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSubmissionRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Submission accepted for asynchronous processing",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/submissions/batch": {
      "post": {
        "summary": "Create bounded batch of submissions (1 to 20 items)",
        "operationId": "createBatchSubmissions",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchSubmissionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Results of batch submission intake",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchSubmissionResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/submissions/{id}": {
      "get": {
        "summary": "Get submission status, verdicts, and execution results",
        "operationId": "getSubmission",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current submission state and results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/submissions/{id}/cancel": {
      "post": {
        "summary": "Cancel a pending or running submission",
        "operationId": "cancelSubmission",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancellation outcome recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/api-keys": {
      "post": {
        "summary": "Generate a new scoped API key",
        "operationId": "createApiKey",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "API key generated (raw_key is displayed only once)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateApiKeyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "summary": "List active API keys for the organization",
        "operationId": "listApiKeys",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active API keys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApiKey"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/api-keys/{id}": {
      "delete": {
        "summary": "Revoke an API key",
        "operationId": "revokeApiKey",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "API key revoked successfully"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/webhooks": {
      "post": {
        "summary": "Register a webhook destination",
        "operationId": "createWebhook",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWebhookRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook registered with signing secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "get": {
        "summary": "List registered webhook destinations",
        "operationId": "listWebhooks",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook destinations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WebhookEndpoint"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/webhooks/{id}": {
      "delete": {
        "summary": "Delete a webhook destination",
        "operationId": "deleteWebhook",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Webhook deleted successfully"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token (ferrum_live_... API key or development master token)"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request parameters or payload",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid, or revoked bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Token lacks required scope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Idempotency conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Quota or concurrency limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "LanguageResponse": {
        "type": "object",
        "required": ["id", "language", "profile", "compiled", "runtime_limits"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "language": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "compiled": {
            "type": "boolean"
          },
          "runtime_limits": {
            "type": "object",
            "properties": {
              "cpu_time_ms": {
                "type": "integer"
              },
              "wall_time_ms": {
                "type": "integer"
              },
              "memory_kib": {
                "type": "integer"
              }
            }
          }
        }
      },
      "CreateSubmissionRequest": {
        "type": "object",
        "required": ["language", "source"],
        "properties": {
          "language": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "stdin": {
            "type": "string",
            "nullable": true
          },
          "expected_output": {
            "type": "string",
            "nullable": true
          },
          "comparison_mode": {
            "type": "string",
            "enum": ["exact", "whitespace_normalized", "tokenized"]
          },
          "tests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestCaseInput"
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "cpu_time_ms": {
                "type": "integer"
              },
              "wall_time_ms": {
                "type": "integer"
              },
              "memory_kib": {
                "type": "integer"
              }
            }
          }
        }
      },
      "TestCaseInput": {
        "type": "object",
        "required": ["expected_output"],
        "properties": {
          "input": {
            "type": "string",
            "nullable": true
          },
          "expected_output": {
            "type": "string"
          },
          "weight": {
            "type": "integer",
            "default": 1
          },
          "hidden": {
            "type": "boolean",
            "default": false
          },
          "comparison_mode": {
            "type": "string",
            "enum": ["exact", "whitespace_normalized", "tokenized"]
          }
        }
      },
      "SubmissionResponse": {
        "type": "object",
        "required": ["id", "state"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": ["created", "queued", "processing", "completed", "failed", "cancelled"]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "accepted",
              "wrong_answer",
              "compilation_error",
              "runtime_error",
              "time_limit_exceeded",
              "memory_limit_exceeded",
              "output_limit_exceeded",
              "internal_error"
            ],
            "nullable": true
          },
          "result": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "BatchSubmissionRequest": {
        "type": "object",
        "required": ["submissions"],
        "properties": {
          "submissions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/BatchSubmissionItem"
            }
          }
        }
      },
      "BatchSubmissionItem": {
        "type": "object",
        "required": ["idempotency_key", "language", "source"],
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "stdin": {
            "type": "string",
            "nullable": true
          },
          "expected_output": {
            "type": "string",
            "nullable": true
          },
          "comparison_mode": {
            "type": "string",
            "enum": ["exact", "whitespace_normalized", "tokenized"]
          },
          "tests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestCaseInput"
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "cpu_time_ms": {
                "type": "integer"
              },
              "wall_time_ms": {
                "type": "integer"
              },
              "memory_kib": {
                "type": "integer"
              }
            }
          }
        }
      },
      "BatchSubmissionResult": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchItemResult"
            }
          }
        }
      },
      "BatchItemResult": {
        "type": "object",
        "required": ["idempotency_key"],
        "properties": {
          "idempotency_key": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "state": {
            "type": "string",
            "enum": ["created", "queued", "processing", "completed", "failed", "cancelled"],
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CancelResponse": {
        "type": "object",
        "required": ["id", "outcome"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": ["cancelled", "cancellation_requested", "already_terminal"]
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "required": ["name", "scopes"],
        "properties": {
          "name": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "submissions:read",
                "submissions:write",
                "submissions:cancel",
                "webhooks:manage",
                "admin"
              ]
            }
          },
          "expires_in_seconds": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CreateApiKeyResponse": {
        "type": "object",
        "required": ["id", "name", "key_prefix", "raw_key", "scopes", "created_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "key_prefix": {
            "type": "string"
          },
          "raw_key": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "integer"
          },
          "expires_at": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ApiKey": {
        "type": "object",
        "required": ["id", "organization_id", "name", "key_prefix", "scopes", "created_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "key_prefix": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "integer"
          },
          "expires_at": {
            "type": "integer",
            "nullable": true
          },
          "revoked_at": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CreateWebhookRequest": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "WebhookEndpoint": {
        "type": "object",
        "required": ["id", "organization_id", "url", "secret", "events", "active", "created_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "integer"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
