      "title": "Accepted intake latency",
      "type": "timeseries",
      "targets": [
        { "expr": "max(k6_intake_duration_p50{scenario=\"intake\"}) * 1000", "legendFormat": "p50", "refId": "A" },
        { "expr": "max(k6_intake_duration_p95{scenario=\"intake\"}) * 1000", "legendFormat": "p95", "refId": "B" },
        { "expr": "max(k6_intake_duration_p99{scenario=\"intake\"}) * 1000", "legendFormat": "p99", "refId": "C" }
